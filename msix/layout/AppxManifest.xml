<?xml version="1.0" encoding="utf-8"?>
<!-- The MSIX manifest. build.ps1 fills in the @TOKENS@ and stages it beside
     polish.exe. See README.md in this folder for what is and is not decided. -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap5 rescap">

  <!-- Name and Publisher are what the Store assigns (Partner Center > Product
       identity); the values here are for local testing and are replaced with
       those at submission. -->
  <Identity Name="Polish.Dev" Publisher="CN=Polish Test" Version="0.5.3.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Polish</DisplayName>
    <PublisherDisplayName>Polish (test)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Polish" Executable="polish.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="Polish"
          Description="Fit and finish for Windows"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start with Windows. A packaged app cannot use the Run registry key
             (its HKCU writes are redirected); this is the supported way. -->
        <uap5:Extension Category="windows.startupTask" Executable="polish.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="PolishStartup" Enabled="false" DisplayName="Polish" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Polish is an ordinary desktop program: global hooks, moving other
         programs' windows. This is what keeps it out of the app sandbox. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

